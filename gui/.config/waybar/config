{
    "layer": "top",        // Above or below windows [top/bottom]
    "position": "bottom",     // [top/bottom/left/right]
    "mode": "dock",           // [dock/hide/invisible/overlay]

    "exclusive": true,
    "gtk-layer-shell": true,
    "passthrough": false,
    "reload_style_on_change": true,

    "height": 33,

    "modules-left": [
        "disk",
        "custom/xbps",
        "custom/temperature",
        "battery",
        "wireplumber",
    ],

    "modules-center": [
        "wlr/taskbar"
    ],

    "modules-right": [
        "tray",
        "clock"
    ],

    // "upower": {
    //     "icon-size": 17,
    //     "hide-if-empty": true,
    //     "tooltip": true,
    //     "tooltip-spacing": 20,
    //     "format": "{percentage}"
    // },

    "custom/temperature": {
        "format": " {}",
        "exec": "status-temperature",
        "on-click": "foot htop",
        "interval": 10,
        "tooltip": false
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        // "rotate": 90,
        "format": "{icon} {capacity}%",
        "format-icons": {
            "default": ["", "", "", "", ""],
            "plugged": ""
        },
        // "max-length": 25,
        "weighted-average": true,
        "tooltip": true,
        "tooltip-format": "power: {power}W\ncycles: {cycles}\nhealth: {health}%\nremaining: {time}"
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": " ",
        "on-click": "pavucontrol",
        "max-volume": 100,
        "scroll-step": 0,
        "format-icons": ["", "", ""]
    },

    "disk": {
        "interval": 30,
        "format": " {free}",
        "path": "/home",
        "on-click": "foot dua i /home",
        "tooltip": false,
        "unit": "GiB"
    },

    "wlr/taskbar": {
        "format": "{icon} {title}",
        "icon-size": 16,
        "spacing": 13,
        "on-click-middle": "close",
        "tooltip": false,
        "ignore-list": [],
        "on-click": "activate",
        // "active-first": true,
        "rewrite": {
            "^(.{16}).+$": "$1…"
        }
    },

    "custom/xbps": {
        "format": " {}",
        "tooltip": false,
        "interval": 60,
        "exec": "status-xbps",
        "hide-empty-text": true
    },

    "tray": {
        "icon-size": 16,
        "show-passive-items": "true",
        "spacing": 13
    },

    "clock": {
        "format": " {:%I:%M %p │ %a, %d/%m}",
        "tooltip-format": "<tt>{calendar}</tt>",

        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 0,

            "format": {
                "months": "<span color='#f4f4f4'><b>{}</b></span>",
                "days": "<span color='#8a8578'>{}</span>",
                "weeks": "<span color='#59564e'>W{}</span>",
                "weekdays": "<span color='#8a8578'><b>{}</b></span>",
                "today": "<span color='#56b4e9'><b><u>{}</u></b></span>"
            }
        }
    }
}
