# set font "Consolas normal 11"

set selection-clipboard clipboard
set guioptions hv
set scroll-page-aware true
set adjust-open "best-fit"
set pages-per-row 2

set page-padding 1

map f toggle_fullscreen

map - zoom out
map = zoom in
map 0 zoom best-fit
map R rotate

map u scroll half-up
map d scroll half-down

map D toggle_page_mode
map r reload
map c recolor
map p print

set default-bg   "#0e0f1a"
set default-fg   "#f4f4f4"

set statusbar-bg "#0e0f1a"
set statusbar-fg "#8a8578"

set inputbar-bg  "#171824"
set inputbar-fg  "#f4f4f4"

set highlight-color        "#f0e442"
set highlight-active-color "#56b4e9"

set notification-error-bg   "#d55e00"
set notification-error-fg   "#0e0f1a"
set notification-warning-bg "#e69f00"
set notification-warning-fg "#0e0f1a"
set notification-bg         "#0e0f1a"
set notification-fg         "#f4f4f4"

set completion-bg           "#0e0f1a"
set completion-fg           "#f4f4f4"
set completion-highlight-bg "#56b4e9"
set completion-highlight-fg "#0e0f1a"

set recolor-lightcolor "#0e0f1a"
set recolor-darkcolor  "#f4f4f4"
set recolor-reverse-video "true"
