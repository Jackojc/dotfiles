#!/usr/bin/env sh

. "$HOME/.local/lib/lib-utils"

should dbus-update-activation-environment
should labwc-sv-start
should awww

dbus-update-activation-environment --all

if is_installed gsettings; then
	gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
	gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
fi

labwc-sv-start

# Wait for wallpaper daemon to start then set a random wallpaper.
# There was an issue where the daemon wasn't started and we'd skip
# setting the wallpaper so just had a black desktop.
if is_installed awww; then
	n=0

	until [ -n "$(awww query 2> /dev/null)" ] || [ "$n" -ge 50 ]; do
		n=$((n + 1))
		sleep 0.1
	done

	tool-wallpaper
fi
