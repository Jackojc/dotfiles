<?xml version="1.0"?>
<labwc_config>

  <!-- autoEnableOutputs is broken on x230 -->
  <core allowTearing="fullscreen" reuseOutputMode="yes" />

  <focus raiseOnFocus="yes" />
  <placement policy="cascade" />
  <resize popupShow="Always" minimumArea="20" />

  <resistance>
    <screenEdgeStrength>20</screenEdgeStrength>
    <windowEdgeStrength>20</windowEdgeStrength>
    <unSnapThreshold>20</unSnapThreshold>
    <unMaximizeThreshold>150</unMaximizeThreshold>
  </resistance>

  <snapping>
    <range inner="20" outer="50" />
    <cornerRange>50</cornerRange>
    <topMaximize>yes</topMaximize>
    <overlay enabled="yes">
      <delay inner="300" outer="300" />
    </overlay>
  </snapping>

  <theme cornerRadius="3" keepBorder="yes" dropShadows="yes" dropShadowsOnTiled="yes">
    <name>ratio-labwc</name>
    <icon>Adwaita</icon>
    <fallbackAppIcon>labwc</fallbackAppIcon>
    <titlebar layout="icon:iconify,max,close" />
    <font name="Lexend" size="12" />
  </theme>

  <windowSwitcher preview="yes" outlines="yes" unshade="yes">
    <osd show="yes" style="thumbnail" output="cursor" thumbnailLabelFormat="%T" />

    <fields>
      <field content="icon" width="5%" />
      <field content="custom" format="%b [%s] %-10O %-10i %T" width="95%" />
    </fields>
  </windowSwitcher>

  <libinput>
    <device category="default" accelProfile="flat" />

    <device category="touchpad">
      <accelProfile>flat</accelProfile>
      <disableWhileTyping>yes</disableWhileTyping>
      <tap>yes</tap>
    </device>

    <device category="TPPS/2 IBM TrackPoint" accelProfile="flat" pointerSpeed="30" />
  </libinput>

  <tablet mapToOutput="DP-7" />

  <regions>
    <region name="left-third"   x="0%"     width="33.34%" y="0%" height="100%" />
    <region name="center-third" x="33.33%" width="33.34%" y="0%" height="100%" />
    <region name="right-third"  x="66.66%" width="33.34%" y="0%" height="100%" />

    <region name="center" x="15%" width="70%" y="10%" height="80%" />

    <region name="top-left-corner"     x="2%"  width="30%" y="2%"  height="30%" />
    <region name="top-right-corner"    x="68%" width="30%" y="2%"  height="30%" />
    <region name="bottom-left-corner"  x="2%"  width="30%" y="68%" height="30%" />
    <region name="bottom-right-corner" x="68%" width="30%" y="68%" height="30%" />
  </regions>

  <windowRules>
    <windowRule identifier="firefox" title="Picture-in-Picture">
      <action name="ToggleAlwaysOnTop" />
      <action name="SetDecorations" decorations="border" />
      <action name="ToggleSnapToRegion" region="top-right-corner" />
    </windowRule>

    <windowRule identifier="firefox" ignoreFocusRequest="yes">
      <action name="SetDecorations" decorations="border" />
    </windowRule>

    <windowRule identifier="*chrom*" ignoreFocusRequest="yes" />

    <windowRule identifier="lxqt-policykit-agent" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="SetDecorations" decorations="border" />
      <action name="ToggleAlwaysOnTop" />
      <action name="AutoPlace" policy="center" />
    </windowRule>

    <windowRule identifier="org.gnupg.pinentry-qt" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="SetDecorations" decorations="border" />
      <action name="AutoPlace" policy="center" />
      <action name="ToggleAlwaysOnTop" />
    </windowRule>

    <windowRule identifier="org.twosheds.iwgtk" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="ToggleAlwaysOnTop" />
      <action name="AutoPlace" policy="center" />
    </windowRule>

    <windowRule identifier="org.pulseaudio.pavucontrol" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="ToggleAlwaysOnTop" />
      <action name="AutoPlace" policy="center" />
    </windowRule>

    <windowRule identifier="handbook-editor">
      <action name="SnapToEdge" direction="left" />
    </windowRule>

    <windowRule identifier="sioyek" title="*handbook.pdf*">
      <action name="SnapToEdge" direction="right" />
    </windowRule>
  </windowRules>

  <!--
    W - window/super/logo
    A - alt
    C - ctrl
    S - shift
  -->
  <keyboard>
    <layoutScope>global</layoutScope>
    <repeatRate>25</repeatRate>
    <repeatDelay>250</repeatDelay>

    <!-- SESSION -->
    <keybind key="W-l">
      <action name="Execute" command="labwc-lock" />
    </keybind>

    <keybind key="Print">
      <action name="Execute" command="tool-screenshot area" />
    </keybind>

    <keybind key="W-Print">
      <action name="Execute" command="tool-screenshot all" />
    </keybind>

    <!-- MENUS -->
    <keybind key="W-S-Tab">
      <action name="ShowMenu" menu="root-menu" />
    </keybind>

    <keybind key="W-a">
      <action name="ShowMenu" menu="launcher-menu" />
    </keybind>

    <keybind key="A-Space">
      <action name="ShowMenu" menu="client-menu" atCursor="yes" />
    </keybind>

    <keybind key="W-Tab">
      <action name="Execute" command="fuzzel" />
    </keybind>

    <!-- APPS -->
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>

    <keybind key="W-S-Return">
      <action name="Execute" command="foot tmux-attach" />
    </keybind>

    <keybind key="W-b">
      <action name="ForEach">
        <query identifier="firefox" />
        <then>
          <action name="Focus" />
          <action name="Raise" />
        </then>
        <none>
          <action name="Execute" command="firefox-wayland" />
        </none>
      </action>
    </keybind>

    <keybind key="W-e">
      <action name="ForEach">
        <query identifier="nemo" />
        <then>
          <action name="Focus" />
          <action name="Raise" />
        </then>
        <none>
          <action name="Execute" command="nemo" />
        </none>
      </action>
    </keybind>

    <keybind key="W-o">
      <action name="Execute" command="foot tool-notes" />
    </keybind>

    <keybind key="W-S-slash">
      <action name="Execute" command="tool-handbook" />
    </keybind>

    <!-- WINDOWS -->
    <keybind key="A-Tab">
      <action name="NextWindow" output="focused" />
    </keybind>

    <keybind key="A-S-Tab">
      <action name="PreviousWindow" output="focused" />
    </keybind>

    <keybind key="W-x">
      <action name="Close" />
    </keybind>

    <keybind key="W-S-x">
      <action name="Kill" />
    </keybind>

    <keybind key="W-f">
      <action name="ToggleFullscreen" />
    </keybind>

    <keybind key="W-S-Space">
      <action name="ToggleMaximize" />
    </keybind>

    <keybind key="W-d">
      <action name="ToggleShowDesktop" />
    </keybind>

    <keybind key="W-t">
      <action name="AutoPlace" policy="automatic" />
      <action name="GrowToEdge" direction="left" />
      <action name="GrowToEdge" direction="right" />
      <action name="GrowToEdge" direction="up" />
      <action name="GrowToEdge" direction="down" />
    </keybind>

    <!-- SNAPPING -->
    <keybind key="W-left">
      <action name="ToggleSnapToEdge" direction="left" combine="yes" />
    </keybind>

    <keybind key="W-right">
      <action name="ToggleSnapToEdge" direction="right" combine="yes" />
    </keybind>

    <keybind key="W-up">
      <action name="ToggleSnapToEdge" direction="up" combine="yes" />
    </keybind>

    <keybind key="W-down">
      <action name="ToggleSnapToEdge" direction="down" combine="yes" />
    </keybind>

    <keybind key="W-S-left">
      <action name="MoveToEdge" direction="left" />
      <action name="GrowToEdge" direction="left" />
      <action name="GrowToEdge" direction="up" />
      <action name="GrowToEdge" direction="down" />
    </keybind>

    <keybind key="W-S-right">
      <action name="MoveToEdge" direction="right" />
      <action name="GrowToEdge" direction="right" />
      <action name="GrowToEdge" direction="up" />
      <action name="GrowToEdge" direction="down" />
    </keybind>

    <keybind key="W-S-up">
      <action name="MoveToEdge" direction="up" />
      <action name="GrowToEdge" direction="up" />
      <action name="GrowToEdge" direction="left" />
      <action name="GrowToEdge" direction="right" />
    </keybind>

    <keybind key="W-S-down">
      <action name="MoveToEdge" direction="down" />
      <action name="GrowToEdge" direction="down" />
      <action name="GrowToEdge" direction="left" />
      <action name="GrowToEdge" direction="right" />
    </keybind>

    <keybind key="W-C-left">
      <action name="GrowToEdge" direction="left" />
    </keybind>

    <keybind key="W-C-right">
      <action name="GrowToEdge" direction="right" />
    </keybind>

    <keybind key="W-C-up">
      <action name="GrowToEdge" direction="up" />
    </keybind>

    <keybind key="W-C-down">
      <action name="GrowToEdge" direction="down" />
    </keybind>

    <keybind key="W-c">
      <action name="ToggleSnapToRegion" region="center" />
    </keybind>

    <keybind key="W-S-1">
      <action name="ToggleSnapToRegion" region="left-third" />
    </keybind>

    <keybind key="W-S-2">
      <action name="ToggleSnapToRegion" region="center-third" />
    </keybind>

    <keybind key="W-S-3">
      <action name="ToggleSnapToRegion" region="right-third" />
    </keybind>

    <keybind key="W-Home">
      <action name="ToggleSnapToRegion" region="top-left-corner" />
      <action name="ToggleAlwaysOnTop" />
    </keybind>

    <keybind key="W-Prior">
      <action name="ToggleSnapToRegion" region="top-right-corner" />
      <action name="ToggleAlwaysOnTop" />
    </keybind>

    <keybind key="W-End">
      <action name="ToggleSnapToRegion" region="bottom-left-corner" />
      <action name="ToggleAlwaysOnTop" />
    </keybind>

    <keybind key="W-Next">
      <action name="ToggleSnapToRegion" region="bottom-right-corner" />
      <action name="ToggleAlwaysOnTop" />
    </keybind>

    <keybind key="W-u">
      <action name="UnSnap" />
    </keybind>

    <!-- OUTPUTS -->
    <keybind key="W-comma">
      <action name="FocusOutput" direction="left" />
    </keybind>

    <keybind key="W-period">
      <action name="FocusOutput" direction="right" />
    </keybind>

    <keybind key="W-S-comma">
      <action name="MoveToOutput" direction="left" />
      <action name="FitToOutput" />
    </keybind>

    <keybind key="W-S-period">
      <action name="MoveToOutput" direction="right" />
      <action name="FitToOutput" />
    </keybind>

    <!-- AUDIO -->
    <keybind key="XF86_AudioLowerVolume" allowWhenLocked="yes">
      <action name="Execute" command="swayosd-client --output-volume -2" />
    </keybind>

    <keybind key="XF86_AudioRaiseVolume" allowWhenLocked="yes">
      <action name="Execute" command="swayosd-client --output-volume +2" />
    </keybind>

    <keybind key="XF86_AudioMute" allowWhenLocked="yes">
      <action name="Execute" command="swayosd-client --output-volume mute-toggle" />
    </keybind>

    <keybind key="XF86_AudioMicMute" allowWhenLocked="yes">
      <action name="Execute" command="swayosd-client --input-volume mute-toggle" />
    </keybind>

    <keybind key="XF86_AudioPlay" allowWhenLocked="yes">
      <action name="Execute" command="playerctl play-pause" />
    </keybind>

    <keybind key="XF86_AudioMedia" allowWhenLocked="yes">
      <action name="Execute" command="playerctl play-pause" />
    </keybind>

    <keybind key="XF86_AudioNext" allowWhenLocked="yes">
      <action name="Execute" command="playerctl next" />
    </keybind>

    <keybind key="XF86_AudioPrev" allowWhenLocked="yes">
      <action name="Execute" command="playerctl previous" />
    </keybind>

    <!-- SCREEN -->
    <keybind key="XF86_MonBrightnessUp" allowWhenLocked="yes">
      <action name="Execute" command="tool-brightness up" />
    </keybind>

    <keybind key="XF86_MonBrightnessDown" allowWhenLocked="yes">
      <action name="Execute" command="tool-brightness down" />
    </keybind>

    <keybind key="C-XF86_MonBrightnessDown" allowWhenLocked="yes">
      <action name="Execute" command="tool-nightmode" />
    </keybind>

    <keybind key="S-XF86_MonBrightnessUp" allowWhenLocked="yes">
      <action name="Execute" command="wlopm --on '*'" />
    </keybind>

    <keybind key="S-XF86_MonBrightnessDown" allowWhenLocked="yes">
      <action name="Execute" command="wlopm --off '*'" />
    </keybind>

    <!-- X230 BACK AND FORWARD -->
    <keybind key="XF86_Back">
      <action name="Execute" command="wtype -P sunPageUp -p sunPageUp" />
    </keybind>

    <keybind key="XF86_Forward">
      <action name="Execute" command="wtype -P sunPageDown -p sunPageDown" />
    </keybind>
  </keyboard>

  <mouse>
    <doubleClickTime>500</doubleClickTime>

    <context name="Frame">
      <mousebind button="W-Left" action="Drag">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Move" />
      </mousebind>

      <mousebind button="W-Right" action="Drag">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Resize" />
      </mousebind>

      <mousebind direction="W-Down" action="Scroll">
        <action name="Focus" />
        <action name="Raise" />
        <action name="ResizeRelative" left="-16%" right="-16%" top="-9%" bottom="-9%" />
      </mousebind>

      <mousebind direction="W-Up" action="Scroll">
        <action name="Focus" />
        <action name="Raise" />
        <action name="ResizeRelative" left="16%" right="16%" top="9%" bottom="9%" />
      </mousebind>
    </context>

    <context name="Border">
      <mousebind button="Left" action="Drag">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Resize" />
      </mousebind>
    </context>

    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>

      <mousebind button="Middle" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>

      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>

    <context name="TitleBar">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>

      <mousebind button="Middle" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>

      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>

      <mousebind direction="Up" action="Scroll">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Shade" />
      </mousebind>

      <mousebind direction="Down" action="Scroll">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Unshade" />
      </mousebind>
    </context>

    <context name="Title">
      <mousebind button="Left" action="Drag">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Move" />
      </mousebind>

      <mousebind button="Right" action="Click">
        <action name="Focus" />
        <action name="Raise" />
        <action name="ShowMenu" menu="client-menu" />
      </mousebind>
    </context>

    <context name="Desktop">
      <mousebind button="Right" action="Click">
        <action name="Unfocus" />
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>

      <mousebind button="Left" action="Press">
        <action name="Unfocus" />
      </mousebind>
    </context>

    <context name="Maximize">
      <mousebind button="Left" action="Click">
        <action name="Focus" />
        <action name="Raise" />
        <action name="ToggleMaximize" />
      </mousebind>
    </context>

    <context name="WindowMenu">
      <mousebind button="Left" action="Click">
        <action name="Focus" />
        <action name="Raise" />
        <action name="ShowMenu" menu="client-menu" atCursor="no" />
      </mousebind>
    </context>

    <context name="Icon">
      <mousebind button="Right" action="Click">
        <action name="Focus" />
        <action name="Raise" />
        <action name="ShowMenu" menu="client-menu" atCursor="no" />
      </mousebind>
    </context>

    <context name="Shade">
      <mousebind button="Left" action="Click">
        <action name="Focus" />
        <action name="Raise" />
        <action name="ToggleShade" />
      </mousebind>
    </context>

    <context name="AllDesktops">
      <mousebind button="Left" action="Click">
        <action name="Focus" />
        <action name="Raise" />
        <action name="ToggleOmnipresent" />
      </mousebind>
    </context>

    <context name="Iconify">
      <mousebind button="Left" action="Click">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Iconify" />
      </mousebind>
    </context>

    <context name="Close">
      <mousebind button="Left" action="Click">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Close" />
      </mousebind>
    </context>
  </mouse>

</labwc_config>
