layer=overlay
anchor=bottom-right

font=Lexend 13.5

sort=-time

outer-margin=13,13,13,13

padding=13
margin=5

width=465
height=287

border-size=1
border-radius=3

# dont trigger events when clicking notifications
actions=0

# always timeout
default-timeout=3000
ignore-timeout=1

background-color=#0e0f1afa
text-color=#f4f4f4
border-color=#59564e
progress-color=over #56b4e94d

# critical stays open until dismissed
[urgency=critical]
border-color=#d55e00
background-color=#d55e00fa
text-color=#0e0f1a
default-timeout=0

[mode=do-not-disturb]
invisible=1

