#!/usr/bin/env sh

set -o errexit -o nounset
. "$HOME/.local/lib/lib-utils"

[ "$#" -eq 1 ] || die 'usage: tool-img-cp <directory>'
[ -d "$1" ] || die "no such directory '$1'"

tool-img-pick |
	xargs --delimiter='\n' --no-run-if-empty -- \
		cp --archive --no-clobber --verbose --target-directory="$1" --
