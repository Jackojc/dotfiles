#!/usr/bin/env sh

# Hacky workaround to let sioyek read from stdin.
# It can't _actually_ read from stdin so we have
# to create temporary file.

set -o errexit -o nounset

cache="${XDG_CACHE_HOME:-$HOME/.cache}/man-pdf"
name=$(printf '%s' "$*" | tr --complement --squeeze-repeats 'A-Za-z0-9._' '-')
out="${cache}/${name}.pdf"

trap 'rm --force "$out"' EXIT

mkdir --parents "$cache"
man -Tpdf "$@" >"$out"

"${READER:-sioyek}" "$out"
