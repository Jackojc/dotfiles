#!/usr/bin/env sh

set -o errexit -o nounset
. "$HOME/.local/lib/lib-utils"

require awww

image=$(
	file --mime-type -- "$DIR_WALLPAPERS"/* |
		grep ': *image/' |
		cut --delimiter=: --fields=1 |
		shuf --head-count=1
)

[ -n "$image" ] || die "'$DIR_WALLPAPERS' is empty"
awww img --resize crop "$image"
