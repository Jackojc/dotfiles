#!/usr/bin/env sh

set -o errexit -o nounset
. "$HOME/.local/lib/lib-utils"

[ "$#" -eq 1 ] || die 'usage: tool-img-mv <directory>'
[ -d "$1" ] || die "no such directory '$1'"

require nsxiv

nsxiv --recursive --stdout --animate . |
	xargs --no-run-if-empty --delimiter='\n' -I{} -- \
		mv --no-clobber --verbose "{}" --target-directory="$1"
