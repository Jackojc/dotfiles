#!/usr/bin/env sh

set -o errexit -o nounset
. "$HOME/.local/lib/lib-utils"

require udisksctl

device=$(lsblk --list --paths --noheadings \
	--filter 'HOTPLUG && TYPE == "part" && MOUNTPOINT' \
	--output NAME,SIZE,LABEL,MOUNTPOINT |
	sed 's/ /\t/' | tool-menu unmount)

udisksctl unmount -b "$device"
