border.width: 1

##############################
########### WINDOW ###########
##############################

# window titlebar padding
window.titlebar.padding.width:  0
window.titlebar.padding.height: 0

# window border
window.active.border.color:   #56b4e9
window.inactive.border.color: #59564e

window.active.indicator.toggled-keybind.color: #e69f00

# window titlebar background.
window.active.title.bg.color:   #0e0f1aFA
window.inactive.title.bg.color: #0e0f1aFA

# window titlebar text
window.active.label.text.color:   #f4f4f4
window.inactive.label.text.color: #8a8578

window.label.text.justify: center

# window button width and spacing
window.button.width:   42
window.button.height:  33
window.button.spacing: 0

# window button hover effect
window.button.hover.bg.color:         #56b4e94d
window.button.hover.bg.corner-radius: 0

# window buttons
window.active.button.unpressed.image.color:   #f4f4f4
window.inactive.button.unpressed.image.color: #8a8578

# window drop-shadows
window.active.shadow.size:   26
window.inactive.shadow.size: 13

window.active.shadow.color:   #00000080
window.inactive.shadow.color: #00000040


############################
########### MENU ###########
############################

menu.overlap.x: 0
menu.overlap.y: 0

menu.width.min: 177
menu.width.max: 591

menu.border.width: 1
menu.border.color: #59564e

menu.items.bg.color:          #0e0f1aFA
menu.items.text.color:        #f4f4f4
menu.items.active.bg.color:   #56b4e9
menu.items.active.text.color: #0e0f1a

menu.items.padding.x: 8
menu.items.padding.y: 5

menu.separator.width: 1
menu.separator.color: #59564e

menu.separator.padding.width: 8
menu.separator.padding.height: 5

menu.title.bg.color:   #292a34FA
menu.title.text.color: #f4f4f4

menu.title.text.justify: center


