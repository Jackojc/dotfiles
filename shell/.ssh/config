KexAlgorithms sntrup761x25519-sha512,sntrup761x25519-sha512@openssh.com,mlkem768x25519-sha256

Compression yes
ServerAliveInterval 120

Host github.com
	User git
	IdentityFile ~/.ssh/github-x230
	IdentityFile ~/.ssh/bigbrother
	IdentitiesOnly yes
	LogLevel QUIET

# Workaround for musl which doesn't have nss-mdns so avahi can't discover devices.
# Works on glibc aswell.
Match host *.local exec "! getent hosts %h"
	ProxyCommand socat - TCP:$(avahi-resolve-host-name -4 %h | cut --fields=2):%p
