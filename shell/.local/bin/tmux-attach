#!/usr/bin/env sh

# attempt to connect to existing
# tmux session that is not currently
# connected to by anyone (orphaned?).
# if there's none, start a new session.

set -o errexit -o nounset
. "$HOME/.local/lib/lib-utils"

[ -z "${TMUX:-}" ] || exit 0

require tmux

session=$(tmux list-sessions -F '#{session_name}' \
	-f '#{==:#{session_attached},0}' 2>/dev/null | head --lines=1)

[ -z "$session" ] || exec tmux attach-session -t "=$session"
exec tmux new-session
