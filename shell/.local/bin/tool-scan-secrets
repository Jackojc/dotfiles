#!/usr/bin/env sh

set -o errexit -o nounset

usage() {
	printf 'usage: %s <dir>\n' "$(basename "$0")"
}

[ "$#" -le 1 ] || { usage >&2; exit 1; }

case "${1:-}" in
	-h | --help | '') usage; exit 0 ;;
	-*) usage >&2; exit 1 ;;
esac

re='gh[oprsu]_[A-Za-z0-9_.-]{36,}
github_pat_[A-Za-z0-9_]{82}
-----BEGIN[ A-Z0-9_-]*PRIVATE KEY( BLOCK)?-----
://[^/:@[:space:]]+:[^/@[:space:]]+@'

# prints every file with a match.
# inverts exit code of grep. found secrets is _not_ success.
! grep --recursive --binary-files=without-match --line-number \
	--extended-regexp "$re" --exclude-dir=.git -- "$1"
