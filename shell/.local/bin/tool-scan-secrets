#!/usr/bin/env sh

# Tries to find secrets recursively.

set -o errexit -o nounset

usage() {
	printf 'usage: %s <dir>\n' "$(basename "$0")"
}

case "${1:-}" in
	-h | --help) usage; exit 0 ;;
	'') usage >&2; exit 2 ;;
esac

re='gh[oprsu]_[A-Za-z0-9_.-]{36,}
github_pat_[A-Za-z0-9_]{82}
-----BEGIN[ A-Z0-9_-]*PRIVATE KEY( BLOCK)?-----
://[^/:@[:space:]]+:[^/@[:space:]]+@'

! grep --recursive --binary-files=without-match --files-with-matches \
	--extended-regexp "$re" --exclude-dir=.git -- "$1"
