#!/usr/bin/env bash

# pash - simple password manager.

# Ensure that debug mode is never enabled to
# prevent the password from leaking.
set +x

# Ensure that globbing is globally disabled
# to avoid insecurities with word-splitting.
set -o noglob

. "$HOME/.local/lib/lib-utils"

require gpg

PASH_DIR=${PASH_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/pash}
PASH_LENGTH=${PASH_LENGTH:-50}
PASH_PATTERN=${PASH_PATTERN:-_A-Z-a-z-0-9}
PASH_TIMEOUT=${PASH_TIMEOUT:-15}

usage() {
	printf %s "\
usage: $(basename "$0") <command> [name]

  [a]dd  <name>   create a new password entry.
  [c]opy <name>   copy entry to the clipboard.
  [d]el  <name>   delete a password entry.
  [s]how <name>   show password for an entry.
  [q]r   <name>   show password as a qr code.
  [l]ist          list all entries.

store:      $PASH_DIR
length:     export PASH_LENGTH=$PASH_LENGTH
pattern:    export PASH_PATTERN=$PASH_PATTERN
key pair:   export PASH_KEYID=XXXXXXXX
timeout:    export PASH_TIMEOUT=$PASH_TIMEOUT ('off' to disable)
"
}

to_clipboard() {
	sum=$(tool-copy | sha256sum)

	[ "$PASH_TIMEOUT" != off ] || return 0

	printf 'clearing the clipboard in %s seconds.\n' "$PASH_TIMEOUT"
	(
		sleep "$PASH_TIMEOUT"

		[ "$(wl-paste --no-newline | sha256sum)" != "$sum" ] ||
			wl-copy --clear
	) < /dev/null > /dev/null 2>&1 &
}

pw_show() {
	gpg --decrypt --quiet "$1.gpg"
}

pw_add() {
	if yn 'generate?'; then
		# Regarding usage of '/dev/urandom' instead of '/dev/random'.
		# See: https://www.2uo.de/myths-about-urandom
		pass=$(LC_ALL=C tr --delete --complement "$PASH_PATTERN" \
			< /dev/urandom | head --bytes="$PASH_LENGTH")

	else
		IFS= read -r -s -p 'password: ' pass || exit 1
		echo >&2

		IFS= read -r -s -p 'again: ' again || exit 1
		echo >&2

		[ "$pass" = "$again" ] || die 'passwords do not match'
	fi

	[ -n "$pass" ] || die 'empty password'

	if [ -n "${PASH_KEYID:-}" ]; then
		mode=(--trust-model always --armor --encrypt
			--recipient "$PASH_KEYID")

	else
		mode=(--symmetric)
	fi

	mkdir --parents "$(dirname "$1")"

	# A heredoc is used here instead of a 'printf' to avoid
	# leaking the password through the '/proc' filesystem.
	#
	# Heredocs are sometimes implemented via temporary files,
	# however this is typically done using 'mkstemp()' which
	# is more secure than a leak in '/proc'.
	gpg "${mode[@]}" --output "$1.gpg" <<-EOF || die "cannot encrypt '$1'"
		$pass
	EOF

	printf '%s\n' "$pass"
	printf '%s' "$pass" | to_clipboard
}

name=${2:-}

case "${1:-}" in
	-h | --help | help) usage; exit 0 ;;
	l*) ;;
	a* | c* | d* | s* | q*)
		[ -n "$name" ] || die 'missing the [name] argument' ;;
	*) usage >&2; exit 1 ;;
esac

case "$name" in
	*../*) die 'category went out of bounds' ;;
	/*) die "category cannot start with '/'" ;;
esac

umask 077

mkdir --parents "$PASH_DIR" ||
	die "cannot create the password directory '$PASH_DIR'"

cd "$PASH_DIR" || die "cannot enter the password directory '$PASH_DIR'"

case "$1" in
	a*) [ ! -f "$name.gpg" ] || die "pass file '$name' already exists" ;;

	c* | d* | s* | q*)
		[ -f "$name.gpg" ] || die "pass file '$name' does not exist" ;;
esac

# Set 'GPG_TTY' to the current 'TTY' if it
# is unset. Fixes a somewhat rare `gpg` issue.
export GPG_TTY="${GPG_TTY:-$(tty)}"

case "$1" in
	a*) pw_add "$name" ;;
	c*) pw_show "$name" | to_clipboard ;;
	s*) pw_show "$name" ;;
	q*) pw_show "$name" | tool-qr ;;
	l*) find . -type f -name '*.gpg' | sed 's|^\./||; s|\.gpg$||' ;;
	d*)
		yn "delete pass file '$name'?" || exit 0
		rm --force "$name.gpg"

		# Remove empty parent directories of a password
		# entry. It's fine if this fails as it means that
		# another entry also lives in the same directory.
		rmdir --parents "$(dirname "$name")" 2> /dev/null || true ;;
esac
