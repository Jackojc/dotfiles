#!/usr/bin/env bash

set -o errexit -o nounset
. "$HOME/.local/lib/lib-utils"

require man
require fzf
require fuzzel

pages() {
	paste <(man -w -k . 2>/dev/null) <(man -k . 2>/dev/null)
}

if is_terminal; then
	page=$(pages | fzf --delimiter '\t' --with-nth 2 --prompt 'man> ') || exit 1
	exec man -l "${page%%$'\t'*}"
fi

page=$(pages | fuzzel --dmenu --with-nth 2 --accept-nth 1 --prompt 'man> ') || exit 1
exec man-pdf -l "$page"
